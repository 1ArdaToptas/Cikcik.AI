HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
# Comma-separated allowed origins (e.g., https://cicik.ai,https://www.cicik.ai for production)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

TTS_MAX_TEXT_LENGTH=100000
TTS_MIN_SPEED=0.5
TTS_MAX_SPEED=2.0
TTS_MAX_QUEUE=4
TTS_RATE_LIMIT_PER_MINUTE=30

# Relative paths are resolved against the backend/ folder.
PIPER_MODEL_PATH=models/piper/tr_TR-dfki-medium.onnx
PIPER_USE_CUDA=false
