{
  "families": [
    "Garnett",
    "GT Super"
  ],
  "scale": {
    "heading-1": {
      "fontFamily": "Garnett",
      "fontSize": "119px",
      "fontWeight": "700",
      "lineHeight": null,
      "source": "css"
    },
    "heading-2": {
      "fontFamily": "Garnett",
      "fontSize": "83px",
      "fontWeight": "700",
      "lineHeight": null,
      "source": "css"
    },
    "heading-3": {
      "fontFamily": "Garnett",
      "fontSize": "76px",
      "fontWeight": "700",
      "lineHeight": null,
      "source": "css"
    },
    "body": {
      "fontFamily": "GT Super",
      "fontSize": "16px",
      "fontWeight": "400",
      "lineHeight": null,
      "source": "css"
    },
    "caption": {
      "fontFamily": "GT Super",
      "fontSize": "14px",
      "fontWeight": "400",
      "lineHeight": null,
      "source": "css"
    }
  },
  "fontFaces": [
    {
      "family": "GT Super",
      "src": "https://static.cambly.com/fonts/gt-super-text-medium-final.woff2",
      "format": "woff2",
      "weight": "510"
    },
    {
      "family": "GT Super",
      "src": "https://static.cambly.com/fonts/gt-super-text-bold-final.woff2",
      "format": "woff2",
      "weight": "700"
    },
    {
      "family": "Garnett",
      "src": "https://static.cambly.com/fonts/Garnett-Regular.woff",
      "format": "woff",
      "weight": "400"
    },
    {
      "family": "Garnett",
      "src": "https://static.cambly.com/fonts/Garnett-Medium.woff",
      "format": "woff",
      "weight": "510"
    },
    {
      "family": "Garnett",
      "src": "https://static.cambly.com/fonts/Garnett-Semibold.woff",
      "format": "woff",
      "weight": "590"
    }
  ],
  "rules": {
    "maxSizesPerScreen": 4,
    "headingWeightRange": "600-700",
    "bodyWeight": 400,
    "lineHeightBody": 1.5,
    "lineHeightHeading": 1.2
  }
}